# Copy this file to .env for local testing, or set these as Railway environment variables
# (Railway dashboard → your service → Variables tab). Never commit a real .env file.

# From console.anthropic.com — Settings → API Keys → Create Key
ANTHROPIC_API_KEY=

# Make up any long random string yourself, e.g. run: openssl rand -hex 24
# This must match WEIGHT_SLIP_READER_SECRET in the main app's index.html exactly.
SHARED_SECRET=

# Your GitHub Pages origin(s), comma-separated if you test locally too.
# No trailing slash, no path — just the origin.
ALLOWED_ORIGIN=https://abdulqadir123370.github.io,http://localhost:5500,http://127.0.0.1:5500
